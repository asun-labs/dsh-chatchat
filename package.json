{
  "name": "dsh-chatchat",
  "version": "0.1.4",
  "license": "Apache-2.0",
  "type": "module",
  "description": "DSH ChatChat 团队智能体与群聊插件",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asun-labs/dsh-chatchat.git"
  },
  "homepage": "https://github.com/asun-labs/dsh-chatchat#readme",
  "bugs": "https://github.com/asun-labs/dsh-chatchat/issues",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "index.js",
    "web-search.js",
    "office.js",
    "office.js.map",
    "lib",
    "src",
    "assets",
    "scripts/build*.mjs",
    "third-party",
    "LICENSE",
    "NOTICE",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "pack:release": "node scripts/pack.mjs",
    "test": "node test/run.mjs",
    "test:package": "node --test tests/package.test.mjs",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./client-api": "./lib/client-api.cjs",
    "./client-source": "./src/client/index.js",
    "./web-search": "./web-search.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
