    "@deepseek-ai/dsh-web": ">=0.2.2-rc.3 <0.3.0",
    "playwright": ">=1.64.1 <2.0.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
